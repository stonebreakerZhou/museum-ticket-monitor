; 国博余票监控 - 配置文件示例
; 复制为 config.ini 后按需修改，config.ini 不会被 git 跟踪

[monitor]
; 要监控的目标日期列表（YYYY-MM-DD，逗号分隔）
; 留空 = 监控所有可约日期
; 填具体日期 = 只监控这几个，例如 target_dates = 2026-08-23,2026-08-30
; 启动时仍可手动输入覆盖此值
target_dates =

; 轮询间隔在运行时选择（5/10/15/30/60/100/300/600 秒），不在此处配置

[museum]
; 国博英文版公开 API（无需登录、无个人信息风险）
; 实际请求固定为 /pool/ingore/getCalendar，按 hallType=91 拿真实库存
; 此处只配 channel，一般不用改
api_channel = pc

[notifier]
; 通知方式：off / serverchan / email / both
type = off

; Server酱配置（推送到微信，免费）
; 申请地址：https://sct.ftqq.com/
serverchan_sendkey =

; 邮件配置（QQ 邮箱示例，其他邮箱改 smtp_host 即可）
; smtp_pass 是 SMTP 授权码，不是登录密码
smtp_host = smtp.qq.com
smtp_port = 465
smtp_user =
smtp_pass =
mail_to =
